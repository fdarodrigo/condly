// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelVinculo {
  ADMINISTRADORA
  SINDICO
  CONDOMINO
}

enum StatusCobranca {
  PENDENTE
  PAGO
  ATRASADO
  EM_ACORDO
}

enum StatusChamado {
  PENDENTE_TRIAGEM
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
}

// Categorias fixas para agrupamento em métricas e relatórios.
// Armazenado como String no banco pra não quebrar migrations com dados
// legados — a validação enum é feita no DTO (mesmo padrão de Documento.tipo).
// Valores válidos: MANUTENCAO | VAZAMENTO | BARULHO | LIMPEZA | SEGURANCA
//                  | ILUMINACAO | ELEVADOR | AREA_COMUM | PORTARIA | OUTRO

enum CanalAviso {
  APP
  EMAIL
  WHATSAPP
}

enum StatusReserva {
  CONFIRMADA
  CANCELADA
}

enum VisibilidadeDocumento {
  TODOS
  SINDICO_ADMINISTRADORA
}

enum TipoEnquete {
  GESTAO
  SERVICO
}

enum StatusEnquete {
  RASCUNHO
  ATIVA
  ENCERRADA
}

model Administradora {
  id           String   @id @default(cuid())
  nome         String
  emailContato String
  criadoEm     DateTime @default(now())

  condominios Condominio[]
  vinculos    VinculoUsuario[]
}

model Condominio {
  id                String  @id @default(cuid())
  administradoraId  String
  nome              String
  endereco          String
  cnpj              String  @unique
  telefone          String?
  email             String?
  // null = todos os toggles permitidos (compatibilidade com dados anteriores)
  permissoesSindico Json?
  subcontaGatewayId String?

  administradora     Administradora     @relation(fields: [administradoraId], references: [id])
  unidades           Unidade[]
  vinculos           VinculoUsuario[]
  chamados           Chamado[]
  documentos         Documento[]
  avisos             Aviso[]
  areasComuns        AreaComum[]
  servicosPeriodicos   ServicoPeriodico[]
  acoesAdministrativas AcaoAdministrativa[]
  enquetes             Enquete[]
  assembleias          Assembleia[]
  advertencias         Advertencia[]

  @@index([administradoraId])
}

model Unidade {
  id            String @id @default(cuid())
  condominioId  String
  identificador String
  tipo          String

  // Dados do responsável financeiro da unidade — opcionais por ora (não há
  // tela de cadastro ainda), mas o Asaas exige cpfCnpj pra emitir cobrança
  // em produção. Sem isso, FinanceiroService só permite cobrança em sandbox.
  responsavelNome    String?
  responsavelEmail   String?
  responsavelCpfCnpj String?

  condominio   Condominio       @relation(fields: [condominioId], references: [id])
  vinculos     VinculoUsuario[]
  cobrancas    Cobranca[]
  chamados     Chamado[]
  avisos       Aviso[]
  reservas     Reserva[]
  conversasBot ConversaBot[]
  advertencias Advertencia[]
  dadosUnidade DadosUnidade?

  @@unique([condominioId, identificador])
  @@index([condominioId])
}

model Usuario {
  id               String  @id @default(cuid())
  nome             String
  email            String  @unique
  telefoneWhatsapp String?
  senhaHash        String

  vinculos               VinculoUsuario[]
  chamadosAbertos        Chamado[]        @relation("ChamadoAbertoPor")
  chamadosResponsavel    Chamado[]        @relation("ChamadoResponsavel")
  avisoLeituras          AvisoLeitura[]
  votos                  VotoEnquete[]
  advertenciasEnviadas   Advertencia[]    @relation("AdvertenciaRemetente")
}

model VinculoUsuario {
  id               String       @id @default(cuid())
  usuarioId        String
  papel            PapelVinculo
  administradoraId String?
  condominioId     String?
  unidadeId        String?

  usuario        Usuario         @relation(fields: [usuarioId], references: [id])
  administradora Administradora? @relation(fields: [administradoraId], references: [id])
  condominio     Condominio?     @relation(fields: [condominioId], references: [id])
  unidade        Unidade?        @relation(fields: [unidadeId], references: [id])

  @@index([usuarioId])
  @@index([administradoraId])
  @@index([condominioId])
  @@index([unidadeId])
}

model Cobranca {
  id               String         @id @default(cuid())
  unidadeId        String
  valor            Decimal        @db.Decimal(10, 2)
  vencimento       DateTime       @db.Date
  status           StatusCobranca
  idExternoGateway String?
  // Link hospedado pelo gateway (2ª via de boleto/PIX) — capturado da
  // resposta do Asaas na criação, nunca reconstruído a partir de um padrão
  // de URL assumido (ver AsaasClient). Usado pelo bot do WhatsApp (Prompt 9).
  linkPagamento    String?
  pagoEm           DateTime?

  unidade Unidade @relation(fields: [unidadeId], references: [id])

  @@index([unidadeId])
}

model Chamado {
  id            String        @id @default(cuid())
  condominioId  String
  unidadeId     String?
  abertoPorId   String
  responsavelId String?
  titulo        String        @default("")
  descricao     String?
  categoria     String
  status        StatusChamado
  criadoEm      DateTime      @default(now())
  atualizadoEm  DateTime      @updatedAt
  reabertoEm    DateTime?

  condominio  Condominio @relation(fields: [condominioId], references: [id])
  unidade     Unidade?   @relation(fields: [unidadeId], references: [id])
  abertoPor   Usuario    @relation("ChamadoAbertoPor", fields: [abertoPorId], references: [id])
  responsavel Usuario?   @relation("ChamadoResponsavel", fields: [responsavelId], references: [id])

  @@index([condominioId])
  @@index([unidadeId])
  @@index([abertoPorId])
  @@index([responsavelId])
  @@index([categoria])
}

model Documento {
  id           String                @id @default(cuid())
  condominioId String
  tipo         String
  // Guarda a key do objeto no R2, não uma URL pública — o arquivo só é
  // acessível via signed URL de curta duração (ver DocumentosService).
  urlArquivo   String
  visibilidade VisibilidadeDocumento
  criadoEm     DateTime              @default(now())

  condominio Condominio @relation(fields: [condominioId], references: [id])

  @@index([condominioId])
}

model Aviso {
  id           String       @id @default(cuid())
  condominioId String
  unidadeId    String?
  titulo       String
  corpo        String
  canais       CanalAviso[]
  enviadoEm    DateTime?

  condominio Condominio     @relation(fields: [condominioId], references: [id])
  unidade    Unidade?       @relation(fields: [unidadeId], references: [id])
  leituras   AvisoLeitura[]

  @@index([condominioId])
  @@index([unidadeId])
}

// Uma linha por (aviso, destinatário do escopo) — existe só pro canal APP.
// `lidoEm` null é o estado "não lido" consultado por GET /usuarios/me/avisos;
// não tem condominioId/unidadeId próprio porque o tenant já foi validado no
// momento da criação (AvisosService só cria linhas pros usuários que
// realmente têm vínculo no escopo do aviso) — ver CLAUDE.md.
model AvisoLeitura {
  id        String    @id @default(cuid())
  avisoId   String
  usuarioId String
  lidoEm    DateTime?

  aviso   Aviso   @relation(fields: [avisoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([avisoId, usuarioId])
  @@index([avisoId])
  @@index([usuarioId])
}

model AreaComum {
  id            String @id @default(cuid())
  condominioId  String
  nome          String
  regrasReserva Json

  condominio Condominio @relation(fields: [condominioId], references: [id])
  reservas   Reserva[]

  @@index([condominioId])
}

model Reserva {
  id          String        @id @default(cuid())
  areaComumId String
  unidadeId   String
  inicio      DateTime
  fim         DateTime
  status      StatusReserva
  criadoEm   DateTime      @default(now())

  areaComum AreaComum @relation(fields: [areaComumId], references: [id])
  unidade   Unidade   @relation(fields: [unidadeId], references: [id])

  @@index([areaComumId])
  @@index([unidadeId])
}

// Contrato de manutenção recorrente do condomínio (elevador, dedetização,
// extintores, gerador etc.) — não existia model nenhum pra isso até aqui;
// criado minimamente só pra sustentar "próximos vencimentos" no dashboard
// (Prompt 8). Sem endpoint de cadastro neste prompt (mesmo padrão já usado
// pra AreaComum no Prompt 5: criado só via seed/script); se um endpoint de
// cadastro for criado depois, validar esse shape explicitamente.
model ServicoPeriodico {
  id                String   @id @default(cuid())
  condominioId      String
  nome              String
  proximoVencimento DateTime @db.Date
  criadoEm          DateTime @default(now())

  condominio Condominio @relation(fields: [condominioId], references: [id])

  @@index([condominioId])
}

model Enquete {
  id           String        @id @default(cuid())
  condominioId String
  titulo       String
  descricao    String?
  tipo         TipoEnquete
  status       StatusEnquete @default(RASCUNHO)
  anonima      Boolean       @default(false)
  inicioEm     DateTime      @db.Date
  fimEm        DateTime      @db.Date
  criadoEm     DateTime      @default(now())

  condominio Condominio     @relation(fields: [condominioId], references: [id])
  opcoes     OpcaoEnquete[]
  votos      VotoEnquete[]

  @@index([condominioId])
}

model OpcaoEnquete {
  id        String @id @default(cuid())
  enqueteId String
  texto     String
  ordem     Int

  enquete Enquete       @relation(fields: [enqueteId], references: [id])
  votos   VotoEnquete[]

  @@index([enqueteId])
}

model VotoEnquete {
  id        String   @id @default(cuid())
  enqueteId String
  opcaoId   String
  usuarioId String
  votadoEm  DateTime @default(now())

  enquete Enquete      @relation(fields: [enqueteId], references: [id])
  opcao   OpcaoEnquete @relation(fields: [opcaoId], references: [id])
  usuario Usuario      @relation(fields: [usuarioId], references: [id])

  @@unique([enqueteId, usuarioId])
  @@index([enqueteId])
  @@index([opcaoId])
}

model AcaoAdministrativa {
  id           String    @id @default(cuid())
  condominioId String
  titulo       String
  descricao    String?
  realizadaEm  DateTime  @db.Date
  validoAte    DateTime? @db.Date
  criadoEm     DateTime  @default(now())

  condominio Condominio @relation(fields: [condominioId], references: [id])

  @@index([condominioId])
}

// unidadeId é opcional porque a conversa é registrada mesmo quando o
// telefoneWhatsapp não está vinculado a nenhum Usuario/Unidade ainda
// (auditoria de toda interação, inclusive tentativas de número não
// cadastrado — ver BotService). Nunca é a fonte de autoridade pra decidir
// o que o bot responde; é só o melhor vínculo conhecido pra fins de
// histórico/auditoria.
model ConversaBot {
  id               String   @id @default(cuid())
  unidadeId        String?
  telefoneWhatsapp String
  mensagens        Json
  // Estado do fluxo multi-turno em andamento (reserva, chamado) — null
  // quando não há fluxo ativo. Shape: { tipo, etapa, dados, atualizadoEm }
  // (ver bot/fluxos/tipos.ts). Expira por inatividade, nunca é fonte de
  // autoridade: a identidade continua vindo só do telefoneWhatsapp.
  fluxo            Json?
  criadoEm         DateTime @default(now())

  unidade Unidade? @relation(fields: [unidadeId], references: [id])

  @@index([unidadeId])
  @@index([telefoneWhatsapp])
}

enum TipoAssembleia {
  ORDINARIA
  EXTRAORDINARIA
}

enum StatusAssembleia {
  AGENDADA
  REALIZADA
  CANCELADA
}

model Assembleia {
  id             String           @id @default(cuid())
  condominioId   String
  titulo         String
  tipo           TipoAssembleia
  status         StatusAssembleia @default(AGENDADA)
  dataHora       DateTime
  local          String?
  linkGravacao   String?
  acrescimoTaxa  Decimal?
  acrescimoAte   DateTime?
  criadoEm       DateTime         @default(now())

  condominio Condominio          @relation(fields: [condominioId], references: [id])
  pautas     PautaAssembleia[]
  documentos AssembleiaDocumento[]

  @@index([condominioId])
}

model PautaAssembleia {
  id           String  @id @default(cuid())
  assembleiaId String
  ordem        Int
  titulo       String
  descricao    String?
  deliberacao  String?

  assembleia Assembleia @relation(fields: [assembleiaId], references: [id])

  @@index([assembleiaId])
}

model AssembleiaDocumento {
  id           String  @id @default(cuid())
  assembleiaId String
  titulo       String
  url          String?

  assembleia Assembleia @relation(fields: [assembleiaId], references: [id])

  @@index([assembleiaId])
}

// Dados complementares de uma unidade: perfil habitacional preenchido pela
// ADM/SINDICO para subsidiar o atendimento de chamados. Campos sensíveis
// (saúde, mobilidade) — só lidos por SINDICO e ADMINISTRADORA (CLAUDE.md).
// statusOcupacao: PROPRIETARIO | INQUILINO | VAZIA
// veiculos: JSON array de { placa, modelo, cor }
model DadosUnidade {
  id                        String  @id @default(cuid())
  unidadeId                 String  @unique
  bebeRecemNascido          Boolean @default(false)
  trabalhadorNoturno        Boolean @default(false)
  pessoasIdosas             Boolean @default(false)
  pets                      Boolean @default(false)
  petsDescricao             String?
  pessoasAutismo            Boolean @default(false)
  pessoasAutismoDescricao   String?
  estrangeiros              Boolean @default(false)
  mobilidadeReduzida        Boolean @default(false)
  locacaoCurtaTemporada     Boolean @default(false)
  statusOcupacao            String  @default("PROPRIETARIO")
  veiculos                  Json    @default("[]")
  contatoEmergenciaNome     String?
  contatoEmergenciaTelefone String?

  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
}

// Advertência formal emitida por ADM/SINDICO a uma unidade específica.
// Motivo armazenado como String (mesmo padrão de Chamado.categoria):
// valores válidos: BARULHO | DESCUMPRIMENTO_REGRAS | DANO_PATRIMONIO
//                  | INADIMPLENCIA | CONDUTA_INADEQUADA | OUTRO
model Advertencia {
  id           String   @id @default(cuid())
  condominioId String
  unidadeId    String
  remetenteId  String
  motivo       String
  descricao    String
  criadoEm     DateTime @default(now())

  condominio Condominio @relation(fields: [condominioId], references: [id])
  unidade    Unidade    @relation(fields: [unidadeId], references: [id])
  remetente  Usuario    @relation("AdvertenciaRemetente", fields: [remetenteId], references: [id])

  @@index([condominioId])
  @@index([unidadeId])
  @@index([remetenteId])
}
