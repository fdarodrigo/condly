# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://condly:condly@localhost:5433/condly_dev?schema=public"

# Banco usado por `npm run test:integration` — nunca aponta pro mesmo
# banco do DATABASE_URL, pra não derrubar dados de dev sob migration/reset.
TEST_DATABASE_URL="postgresql://condly:condly@localhost:5433/condly_test?schema=public"

# Porta do backend NestJS. O frontend (apps/web) usa a 3000 por padrão,
# por isso a API roda numa porta diferente em dev.
PORT=3001

# Segredo de assinatura dos JWTs de autenticação. Em produção isso vem de
# um secret manager — nunca o mesmo valor de dev/teste.
JWT_SECRET="dev-secret-troque-em-producao"
JWT_EXPIRES_IN="1h"

# Gateway de pagamento Asaas — crie uma conta sandbox gratuita e gere a API
# Key em https://sandbox.asaas.com (veja o passo a passo no README). Use
# api-sandbox.asaas.com em dev/teste, api.asaas.com só em produção.
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY="troque-pela-sua-api-key-sandbox"
# Token que você mesmo define ao criar o webhook no painel do Asaas —
# precisa ser EXATAMENTE o mesmo valor configurado lá.
ASAAS_WEBHOOK_TOKEN="troque-por-um-token-forte"
# "sandbox" (padrão) ou "production". Em produção, FinanceiroService recusa
# criar cobrança pra unidade sem responsavelCpfCnpj cadastrado, em vez de
# deixar o Asaas falhar silenciosamente na criação do cliente.
ASAAS_ENV="sandbox"